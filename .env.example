# Copie ce fichier en .env et colle ta clé API (une clé par usage : ordinateur, serveur, bot).
XOZHUB_API_KEY=xgpt_ta_cle_ici

# Service X.GPT : la base URL est la même pour tout le compte.
XOZHUB_BASE_URL=https://xgpt-api.xshe.workers.dev/v1

# Modèles du compte (raccourcis xgpt-*) : xgpt-code, xgpt-smart, xgpt-deepseek, xgpt-sol,
# xgpt-kimi, xgpt-glm, xgpt-flash, xgpt-mini.
# Par défaut : xgpt-code (le meilleur du compte pour le code et les sites). Si le modèle écrit
# ici n'existe pas, l'IA bascule toute seule sur le meilleur disponible.
XOZHUB_MODEL=xgpt-code

# Mode automatique : l'agent exécute ses commandes sans demander O/N.
# 1 = tout exécuter, 0 = demander confirmation (commande /auto pour changer à chaud).
XOZHUB_AUTO=1

# Concentration : plus bas = plus prévisible et plus collé à la demande.
# 0.2 par défaut ; 0 = le plus strict ; « off » = paramètre non envoyé.
XOZHUB_TEMPERATURE=0.2

# Couleurs de l'interface : truecolor (le plus beau, défaut), 256 ou 16 pour un vieux
# terminal, none pour couper. À chaud dans l'app : /couleurs truecolor
# XOZHUB_COLOR=truecolor

# Taille maximale d'un document joint au modèle : un fichier lu, un site analysé, une image.
# 40000 par défaut ; « off » pour ne rien couper.
# XOZHUB_DOCUMENT_MAX=40000

# Relecture automatique : avant de te rendre la main, l'agent est renvoyé sur ses propres
# fichiers (design, mobile, finitions pour une page ; propreté et vérification pour du code).
# off = couper. Le contrôle des références cassées et le contrôle qualité, eux, restent actifs.
# XOZHUB_RELECTURE=on
