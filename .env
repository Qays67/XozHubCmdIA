# XozHub — la clé et les réglages. Ce fichier reste sur cette machine.
# Il est lu par l'interface graphique (ia/serveur.mjs) comme par le terminal (bin/xozhub.js).

XOZHUB_API_KEY=xgpt_0cf69bd67cecadaf44c94e2e46c78d945cce5054bd8645c507cfe7dc8dc351a7
XOZHUB_BASE_URL=https://xgpt-api.xshe.workers.dev/v1
XOZHUB_MODEL=xgpt-code
XOZHUB_AUTO=1
XOZHUB_TEMPERATURE=0.2

# ---------------------------------------------------------------------------
# Connexion : le code à 4 chiffres envoyé par email (voir ia/README.md).
# Avec une clé Resend, le code part pour de vrai. Sans clé, il s'affiche
# dans la fenêtre de connexion — la connexion marche quand même.
# RESEND_API_KEY=re_ta_cle_ici
# XOZHUB_MAIL_FROM=XozHub.AI <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# Sites : le lien public, envoyable à n'importe qui (marche même IA fermée).
# Jeton gratuit sur https://vercel.com/account/tokens
# VERCEL_TOKEN=ton_jeton_vercel
