# XozHub.GPT — configuration locale (ne pas partager, ne pas committer).
# Une clé par usage : celle-ci est celle de cette machine.

XOZHUB_API_KEY=xgpt_62ebf5a474421e281626deadc8f502b749ad0602e9e400e9cb9ec298cc310ae5

# Service X.GPT : la base URL est la même pour tout le compte.
XOZHUB_BASE_URL=https://xgpt-api.xshe.workers.dev/v1

# Modèles du compte (raccourcis xgpt-*) : xgpt-glm, xgpt-mini, xgpt-smart,
# xgpt-flash, xgpt-sol, xgpt-code, xgpt-kimi, xgpt-deepseek.
XOZHUB_MODEL=xgpt-code

# Mode automatique : l'agent exécute ses commandes sans demander O/N.
XOZHUB_AUTO=1

# Concentration : plus bas = plus prévisible et plus collé à la demande.
XOZHUB_TEMPERATURE=0.2
